{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "lakebed/server": [
        "../node_modules/lakebed/dist/server.d.ts"
      ],
      "preact": [
        "../node_modules/preact/src/index.d.ts"
      ],
      "preact/*": [
        "../node_modules/preact/*"
      ]
    }
  },
  "include": [
    "client/**/*",
    "server/**/*"
  ]
}
